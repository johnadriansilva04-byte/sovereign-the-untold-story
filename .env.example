# Configuração pública do SOVEREIGN (Supabase).
# A chave "publishable" roda no navegador e é protegida por RLS.
# NUNCA coloque aqui a chave "secret"/service_role.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Comandante LLM (opcional). Sem estas variáveis, a dificuldade "Comandante IA (LLM)"
# cai automaticamente para a IA tática local — o jogo funciona 100% offline.
SOVEREIGN_LLM_BASE_URL=
SOVEREIGN_LLM_API_KEY=
SOVEREIGN_LLM_MODEL=
